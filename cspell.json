{
  "version": "0.2",
  "language": "en,es",
  "ignorePaths": [
    ".git/**",
    "build/**",
    "dist/**",
    "*.exe",
    "*.pyz"
  ],
  "ignoreRegExpList": [
    "/\\b[A-Z_][A-Z0-9_]{2,}\\b/g",
    "/\\b\\$[A-Z0-9_]+\\b/g",
    "/\\bT-[A-Z0-9]+\\b/g"
  ],

    "afters",
    "agr",
    "agrs",
    "auth",
    "befores",
    "codederror",
    "cp",
    "dedup",
    "gui",
    "infile",
    "latin",
    "logrows",
    "logpath",
    "mandt",
    "mod",
    "neu",
    "outfile",
    "outdir",
    "sap",
    "sysid",
    "tabulada",
    "tcode",
    "txool",
    "ufeff",
    "varbl",
    "objct",
    "warns",
    "werks"
  ]
}
